# -----------------------------------------------------------------------------
# GisAra Application Production Configuration
# -----------------------------------------------------------------------------

# Server Runtime & Port
NODE_ENV=production
PORT=3000

# Proxy Trust Configuration (set to "1" or "true" if behind Nginx/Cloudflare/Caddy)
TRUST_PROXY=

# Security & Session Authentication (Min 32 random characters: openssl rand -hex 32)
JWT_SECRET=

# Admin Master Password Hash (Generate with: node scripts/hash-admin-password.js "<password>")
ADMIN_PASSWORD_HASH=

# Public site URL (no trailing slash). Pins the payment-gateway callback so a spoofed Host header can never redirect it.
PUBLIC_BASE_URL=https://gisara.ir

# Payment Gateway (ZarinPal Merchant ID)
ZARINPAL_MERCHANT_ID=

# SMS Service Provider (Kavenegar Web Service Key & OTP Lookup Pattern)
KAVENEGAR_API_KEY=
KAVENEGAR_PATTERN_CODE=otp_verify
# Pre-approved Kavenegar template for order confirmations (token = order number, token2 = payment ref). Unset = no SMS.
KAVENEGAR_ORDER_TEMPLATE=
FARAZSMS_ORDER_PATTERN=

# AI Styling Assistant (Google Gemini API Key)
GEMINI_API_KEY=

# Security Origins & CSP Customization (Optional, comma-separated)
ALLOWED_ORIGINS=
CSP_FRAME_ANCESTORS=
